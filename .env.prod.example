# Copie para `.env` NO SERVIDOR (o .env real nunca vai para o Git) e preencha:
#   MONGO_ROOT_PASSWORD  -> senha aleatória (ex.: openssl rand -hex 24)
#   API_KEY_HASH         -> python3 scripts/gen_key.py   (imprime a chave e o hash; guarde a chave)
MONGO_ROOT_USER=notixias_root
MONGO_ROOT_PASSWORD=<senha-aleatoria>
MONGO_DB=notixias
API_KEY_HASH=sha256:<hash-da-chave>
LOG_LEVEL=info
